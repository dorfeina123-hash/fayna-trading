rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
//  Fayna Trading — Firestore Security Rules  (v109)
//
//  v109 (Israeli privacy-law review): one ruleset for every collection the app uses.
//  The referral, mailing, waitlist, broadcast and push collections from the old
//  merged file are folded in and tightened: the do-not-contact list is no longer
//  readable by every user, login logs must belong to the writer, public request
//  forms accept only their own fields, and a public opt-out record lets the
//  unsubscribe link in marketing mail work without signing in.
//
//  THIS is the real security boundary. The Firebase API key in the HTML is public
//  by design; nothing that runs in the browser can be trusted. These server-side
//  rules are what actually stop a user from reading other people's data or making
//  themselves an admin.
//
//  v50: users CREATE is hardened — email must match the auth token (this was the
//  stored-XSS *source* fixed twice downstream in v46/v48, now blocked at origin),
//  name must be a short string, isAdmin stays non-self-assignable. THIS STAYS.
//
//  v52: the Guard (מלאך שומר) freeze was removed together with the feature.
//  Leaving it in would have been worse than useless: any user whose document
//  still carries a td_guard.lockedUntil in the future would have had every
//  update rejected by a rule enforcing a feature that no longer exists.
//  Leftover td_guard fields are now inert data and are simply ignored.
//
//  Deploy:  Firebase Console → Firestore Database → Rules → paste → Publish
//  (or:  firebase deploy --only firestore:rules)
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // The admin is identified by the email on the auth token (set by Firebase Auth,
    // NOT by any field a user can write). Change this if the admin email changes.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'dorfeina123@gmail.com';
    }
    function managedTrading(uid) {
      return exists(/databases/$(database)/documents/subscriptions/$(uid))
          || exists(/databases/$(database)/documents/trialGrants/$(uid));
    }
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    // v50: the registration paths (doRegister / _gaProvision) always write the
    // lowercased auth email — enforce that so a user cannot be born with an
    // email field containing HTML or someone else's address.
    function createEmailOk() {
      return request.resource.data.email is string
          && request.resource.data.email.lower() == request.auth.token.email.lower();
    }
    function createNameOk() {
      return !('name' in request.resource.data)
          || (request.resource.data.name is string
              && request.resource.data.name.size() <= 120);
    }

    // ── users/{uid} : profile + trading data (td_* fields) ──
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();

      // A user may create ONLY their own doc, may NOT self-assign admin,
      // and (v50) the email field must match the token; name must be sane.
      allow create: if isOwner(uid)
                    && (isAdmin() || request.resource.data.isAdmin == false)
                    && createEmailOk()
                    && createNameOk();

      // A user may update their own doc but may NOT change the privileged fields
      // (isAdmin / plan / status / email). Only the admin can change those.
      allow update: if isAdmin()
                    || ( isOwner(uid)
                         && request.resource.data.isAdmin == resource.data.isAdmin
                         && request.resource.data.plan    == resource.data.plan
                         && request.resource.data.status  == resource.data.status
                         && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                           'isAdmin', 'plan', 'status', 'email', 'planCycle', 'planExpiresAt',
                           'planStatus', 'cancelAtPeriodEnd', 'subscriptionPlan',
                           'subscriptionStatus', 'paymentStatus', 'refRewardsGranted',
                           'providerCustomerId', 'providerSubscriptionId', 'td_workspaceRevision'
                         ])
                         && (!managedTrading(uid) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['td_accounts','td_tradesList'])) );

      allow delete: if isAdmin();
    }

    // ── invites/{email} : plan pre-assignment, consumed at registration ──
    match /invites/{email} {
      // A signed-in user may read/delete only the invite addressed to their email.
      allow read, delete: if isAdmin()
                          || (isSignedIn() && request.auth.token.email == email);
      allow create, update: if isAdmin();
    }

    // ── settings/{doc} : app-wide settings (contact info, EmailJS public config) ──
    match /settings/{doc} {
      allow read:  if isSignedIn();   // app needs contact/EmailJS config
      allow write: if isAdmin();
    }

    // ── loginLogs/{id} : login/register activity ──
    match /loginLogs/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid','email','name','action','timestamp','ua']);
      allow read, update, delete: if isAdmin();
    }

    // ── admin-only collections ──
    match /adminNotes/{id} { allow read, write: if isAdmin(); }
    match /adminLogs/{id}  { allow read, write: if isAdmin(); }

    // Billing collections are server-owned. Even browser admin sessions cannot write.
    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
    match /subscriptionCancellationRequests/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
    match /trialGrants/{uid} { allow read, write: if false; }
    match /billingQuotes/{id} { allow read, write: if false; }
    match /billingEvents/{id} { allow read, write: if false; }
    match /billingOperations/{id} { allow read, write: if false; }

    // ── referrals: who invited whom ──
    match /referrals/{refereeUid} {
      allow create, update: if isOwner(refereeUid);
      allow read: if isSignedIn()
                  && ( resource.data.referrerUid == request.auth.uid
                       || request.auth.uid == refereeUid
                       || isAdmin() );
      allow delete: if isOwner(refereeUid) || isAdmin();
    }
    // Short invite code → uid. Read before sign-in to resolve a code; exposes only a uid.
    // v110: a code can only be claimed once. Before, any user could overwrite another
    // user's code with their own uid and receive that person's referrals, including
    // the referees' names and e-mail addresses.
    match /refCodes/{code} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid','updatedAt']);
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid','updatedAt']);
      allow delete: if isAdmin();
    }
    // Anonymous click counter on an invite link: may only go up by one.
    match /refClicks/{code} {
      allow read: if isSignedIn();
      allow create: if request.resource.data.keys().hasOnly(['count','last'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count','last'])
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    // ── marketing consent ──
    // Do-not-contact list, keyed by e-mail. Holds other people's addresses, so only
    // the admin may list it; a user may check or add only their own address.
    match /dnc/{emailKey} {
      allow read:   if isAdmin()
                    || (isSignedIn() && request.auth.token.email.lower() == emailKey);
      allow create: if isAdmin()
                    || (isSignedIn() && request.auth.token.email.lower() == emailKey);
      allow update, delete: if isAdmin();
    }
    // Opt-out from the link in a marketing e-mail. Works without signing in (the law
    // requires a simple way to refuse); it can only ever switch marketing OFF.
    match /unsubscribes/{uid} {
      allow create, update: if uid.size() <= 64
                            && request.resource.data.keys().hasOnly(['uid','at','via'])
                            && request.resource.data.uid == uid;
      allow read:   if isAdmin() || isOwner(uid);
      allow delete: if isAdmin() || isOwner(uid);
    }
    // Mailing audit trail — append only
    match /mailingLogs/{id} {
      allow create: if isSignedIn();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── requests from the site ──
    match /billing_requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type','plan','cycle','uid','email','provider','createdAt'])
                    && (request.resource.data.uid == null || isOwner(request.resource.data.uid))
                    && (!('email' in request.resource.data)
                        || (request.resource.data.email is string && request.resource.data.email.size() <= 200));
      allow read, update, delete: if isAdmin();
    }
    match /waitlist/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── visual builder: published design is public, written by admin ──
    match /site_design/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /site_design_versions/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ── broadcasts (admin → users); users may only bump the counters ──
    match /broadcasts/{id} {
      allow read:   if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delivered', 'read'])
                        && request.resource.data.delivered >= resource.data.delivered
                        && request.resource.data.read      >= resource.data.read);
    }

    // Web Push subscriptions live under the user document
    match /users/{uid}/pushSubs/{doc} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ── live trade sync (platform add-ons → syncIngest function) ──
    // The browser stores only the SHA-256 of a pairing key; the key itself is shown once.
    match /syncDevices/{hash} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
                    && hash.size() == 64
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid','label','createdAt','revoked'])
                    && request.resource.data.revoked == false
                    && request.resource.data.label is string && request.resource.data.label.size() <= 60;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked','label'])
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
    // Executions written by the server; the owner reads them and builds trades.
    match /users/{uid}/syncFills/{fill} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ── deny everything not explicitly allowed above ──
    // Encrypted Gmail refresh tokens: server only.
    match /gmailTokens/{uid} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
