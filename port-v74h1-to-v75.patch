+// v74h1 — USD/ILS by date: cache, weekend/holiday fallback, offline table, never a fixed 3.65.
+const assert = require('node:assert/strict');
+globalThis.HIST_RATES = { '2026-06': 2.91, '2026-10': 3.073 };
+const store = {}; globalThis.localStorage = { getItem: (k) => store[k] ?? null, setItem: (k, v) => { store[k] = String(v); } };
+const FX = require('../fayna-fx.js');
+// offline: monthly table, then nearest earlier month, then latest
+assert.equal(FX.info().source, 'table');
+assert.equal(FX.rate('2026-10-05'), 3.073);
+assert.equal(FX.rate('2026-08-10'), 2.91);
+// with ECB days loaded
+FX._load({ days: { '2026-10-01': 3.0762, '2026-10-02': 3.0653, '2026-10-05': 3.0623, '2026-10-16': 3.0945 }, fetchedAt: 1 });
+assert.equal(FX.rate('2026-10-01'), 3.0762);
+assert.equal(FX.rate('2026-10-04'), 3.0653, 'weekend uses the previous business day');
+assert.equal(FX.rate('2026-10-12'), 3.0623, 'holiday gap ≤10 days uses the previous published day');
+assert.equal(FX.rate('2026-12-31'), 3.0945, 'future/today uses the latest published rate');
+assert.equal(FX.rate('2026-06-15'), 2.91, 'before the cached range → table');
+assert.equal(FX.rate('garbage') > 1, true);
+// invalid values are ignored
+assert.equal(FX._load({ days: { '2026-10-01': 0, 'x': 3 } }), false);
+console.log('USD/ILS rate checks passed');
