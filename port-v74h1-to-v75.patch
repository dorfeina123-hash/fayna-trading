+// v74h1 — Tradovate Performance export regression (synthetic rows, Tradovate's real column layout).
+const assert = require('node:assert/strict');
+const { parseAny, dedupe, num } = require('../fayna-import.js')._core;
+
+// accounting negatives in every form brokers use
+assert.equal(num('$(12.50)'), -12.5);
+assert.equal(num('$(1,234.50)'), -1234.5);
+assert.equal(num('($12.50)'), -12.5);
+assert.equal(num('(12.50)'), -12.5);
+assert.equal(num('-$12.50'), -12.5);
+assert.equal(num('USD (7.25)'), -7.25);
+assert.equal(num('$1,234.50'), 1234.5);
+assert.equal(num('₪ 1.234,56'), 1234.56);
+assert.equal(num(''), 0);
+
+const H = 'symbol,_priceFormat,_priceFormatType,_tickSize,buyFillId,sellFillId,qty,buyPrice,sellPrice,pnl,boughtTimestamp,soldTimestamp,duration';
+const rows = [
+  'MNQZ6,-2,0,0.25,111,112,2,21000.25,21010.50,$41.00,10/14/2026 09:31:05,10/14/2026 09:35:10,4min 5sec',
+  // short: sold first at 21012, bought back at 21020 → loss
+  'MNQZ6,-2,0,0.25,113,114,1,21020.00,21012.00,$(16.00),10/14/2026 10:02:00,10/14/2026 10:01:00,1min',
+  'ESZ6,-2,0,0.25,115,116,1,5800.00,5790.00,$(500.00),10/15/2026 15:00:00,10/15/2026 15:05:00,5min',
+  // two partial fills of one order: same time, price, qty — different fill ids
+  'MESZ6,-2,0,0.25,201,301,1,5790.00,5795.00,$25.00,10/16/2026 11:00:00,10/16/2026 11:04:00,4min',
+  'MESZ6,-2,0,0.25,202,302,1,5790.00,5795.00,$25.00,10/16/2026 11:00:00,10/16/2026 11:04:00,4min',
+];
+const r = parseAny([H, ...rows].join('\n'), 'auto');
+assert.equal(r.format, 'tradovate');
+assert.deepEqual(r.trades.map((t) => t.pnl), [41, -16, -500, 25, 25], 'losses must stay negative');
+assert.deepEqual(r.trades.map((t) => t.dir), ['long', 'short', 'long', 'long', 'long']);
+assert.deepEqual(r.trades.map((t) => t.date), ['2026-10-14', '2026-10-14', '2026-10-15', '2026-10-16', '2026-10-16']);
+assert.deepEqual(r.trades.map((t) => t.extId), ['111-112', '113-114', '115-116', '201-301', '202-302']);
+assert.deepEqual(r.warnings, []);
+const total = r.trades.reduce((s, t) => s + t.pnl, 0);
+assert.equal(total, -425);
+
+// partial fills are both imported; re-importing the same file adds nothing
+const first = dedupe(r.trades, [], []);
+assert.equal(first.fresh.length, 5);
+const key = (t) => `${t.date}|${t.sym}|${t.buy}|${t.sell}|${(t.btime || '').slice(0, 5)}|${t.qty}`;
+const again = dedupe(r.trades, first.fresh.map(key), first.fresh.map((t) => `${t.src}|${t.extId}`), key);
+assert.equal(again.fresh.length, 0);
+// a journal imported earlier without ids still blocks a duplicate by content
+const legacy = dedupe(r.trades, [key(r.trades[0])], [], key);
+assert.equal(legacy.fresh.length, 4);
