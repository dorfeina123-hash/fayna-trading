--- /dev/null
+++ b/fayna-currency-display.js
@@ -0,0 +1,101 @@
+/* ═════════════════════════════════════════════════════════════════════
+   fayna-currency-display.js — USD/ILS display layer (v75 port of v74h1)
+   ---------------------------------------------------------------------
+   Same behaviour as the v74 hotfix 1 on the live site, implemented as a
+   wrapper module so the inline application code stays untouched (Codex's
+   validate-app guard). Loaded with `defer`, i.e. after the inline scripts.
+
+   1. histRate(date)     → real daily ECB rate (fayna-fx.js) first, the
+                            built-in monthly table only offline.
+   2. toggleCurrency(btn) → the ₪ button used to change only the icon; now
+                            it re-renders home + journal in shekels.
+   3. Conversion is per trade, at the USD/ILS rate of the trade's own date.
+   4. Saved trades are never changed — display only.
+   ═════════════════════════════════════════════════════════════════════ */
+(function () {
+  'use strict';
+  if (typeof window === 'undefined') return;
+
+  var origHist = typeof window.histRate === 'function' ? window.histRate : null;
+  window.histRate = function (d) {
+    if (window.FaynaFX) { var r = window.FaynaFX.rate(String(d || '')); if (r) return +r.toFixed(4); }
+    return origHist ? origHist(String(d || new Date().toISOString().slice(0, 10))) : 3.0;
+  };
+
+  function on() { try { return typeof showILS !== 'undefined' && !!showILS; } catch (e) { return false; } }
+  function conv(usd, date) { var n = Number(usd); return on() ? n * window.histRate(String(date || '')) : n; }
+  function netOf(t) { return conv(tradeNet(t), t && t.date); }
+  function sym() { return on() ? '₪' : '$'; }
+  window._fxOn = on; window._fxConv = conv; window._fxNet = netOf; window._fxSym = sym;
+
+  if (typeof window._homeMoney === 'function') {
+    window._homeMoney = function (value) {
+      return (value < 0 ? '−' : value > 0 ? '+' : '') + sym() + Math.abs(value).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+    };
+  }
+
+  function rerender() {
+    try { if (typeof renderHome === 'function') renderHome(); } catch (e) { /* page not ready */ }
+    try { if (typeof renderTJ === 'function') renderTJ(); } catch (e) { /* page not ready */ }
+  }
+
+  var origToggle = window.toggleCurrency;
+  if (typeof origToggle === 'function') {
+    window.toggleCurrency = function (btn) {
+      origToggle.apply(this, arguments);
+      if (btn) btn.setAttribute('aria-pressed', String(on()));
+      rerender();
+      if (on() && typeof showToast === 'function') showToast('מוצג בשקלים לפי שער הדולר ביום כל עסקה (ביומן ובמסך הבית)', 'info');
+    };
+  }
+
+  /* Journal: the renderer prints USD. Post-process its own output from the
+     same trades (row ids carry the trade index), never from parsed text. */
+  function fixJournal() {
+    var body = document.getElementById('tj-body'), kpi = document.getElementById('tj-m');
+    if (!body || !kpi || typeof tradesList === 'undefined') return;
+    var rows = body.querySelectorAll('tr.tj-row[id^="tj-row-"]');
+    var totUSD = 0, totILS = 0, n = 0, wSum = 0, wN = 0, ils = on();
+    rows.forEach(function (tr) {
+      var t = tradesList[Number(tr.id.slice(7))]; if (!t) return;
+      var usd = Number(tradeNet(t)); if (!isFinite(usd)) return;
+      var rate = window.histRate(String(t.date || '')), shek = usd * rate;
+      totUSD += usd; totILS += shek; n++;
+      if (usd > 0) { wSum += ils ? shek : usd; wN++; }
+      if (ils) {
+        var cell = tr.querySelector('td[data-label^="נטו"]');
+        if (cell && cell.firstChild && cell.firstChild.nodeType === 3) {
+          cell.firstChild.nodeValue = (usd >= 0 ? '+' : '−') + '₪' + Math.abs(shek).toFixed(2);
+          cell.setAttribute('data-label', 'נטו ₪');
+          cell.title = '$' + usd.toFixed(2) + ' × ' + rate;
+        }
+      }
+    });
+    var cards = kpi.querySelectorAll('.mc');
+    if (cards[0]) {
+      var tot = ils ? totILS : totUSD, s = ils ? '₪' : '$';
+      var l = cards[0].querySelector('.mc-l'), v = cards[0].querySelector('.mc-v'), sub = cards[0].querySelector('.mc-s');
+      if (l) l.textContent = 'P&L סה״כ ' + s;
+      if (v) { v.textContent = (tot >= 0 ? '+' : '') + s + tot.toFixed(2); v.className = 'mc-v ' + (tot >= 0 ? 'cg' : 'cr'); }
+      if (sub) { sub.textContent = ils ? '$' + totUSD.toFixed(2) : '₪' + totILS.toFixed(0); sub.title = 'לפי שער הדולר ביום כל עסקה'; }
+    }
+    if (cards[3] && ils) {
+      var av = cards[3].querySelector('.mc-v'), as = cards[3].querySelector('.mc-s');
+      if (av) av.textContent = n ? '₪' + (totILS / n).toFixed(2) : '—';
+      if (as) as.textContent = wN ? 'avg W: ₪' + (wSum / wN).toFixed(1) : '';
+    }
+  }
+  var origTJ = window.renderTJ;
+  if (typeof origTJ === 'function') {
+    window.renderTJ = function () {
+      var r = origTJ.apply(this, arguments);
+      try { fixJournal(); } catch (e) { /* never break the journal */ }
+      return r;
+    };
+  }
+
+  window.addEventListener('fayna:fx-updated', function () {
+    rerender();
+    try { if (typeof financeRender === 'function' && document.getElementById('tp-biz') && document.getElementById('tp-biz').offsetParent) financeRender(); } catch (e) { /* ignore */ }
+  });
+})();
